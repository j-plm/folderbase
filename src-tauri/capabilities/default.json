{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Folderbase's windows: the main window, Settings, Get Info and the Inspector",
  "windows": [
    "main",
    "settings",
    "inspector",
    "info-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:default",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
